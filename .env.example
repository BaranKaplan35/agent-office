# Copy to .env and fill in what you need. .env is git-ignored.
# With no .env at all the app runs in mock mode — no API key required.

# Which model backend to use: mock | gemini | anthropic
LLM_PROVIDER=mock

# Port of the API server (the Vite dev proxy reads this too). Default: 3001
# SERVER_PORT=3001

# Max parallel model calls and per-call timeout
LLM_CONCURRENCY=2
LLM_TIMEOUT_MS=60000

# Mock mode: each fake answer waits a random time in this range (ms)
MOCK_MIN_DELAY_MS=1500
MOCK_MAX_DELAY_MS=4000

# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
