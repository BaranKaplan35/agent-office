# Copy to .env and fill in what you need. .env is git-ignored.
# With no .env at all the app runs in mock mode — no API key, no Ollama required.

# Default model backend for agents without their own `llm` in the team file:
# mock | gemini | anthropic | ollama | openrouter
# `mock` is special: EVERY agent runs on mock, even those with their own `llm`, so
# the app works without any setup. Pick a real provider to use the team files' models.
LLM_PROVIDER=mock

# Keep tasks across server restarts in a JSON file (git-ignored). Default: true.
# PERSIST_TASKS=true
# TASKS_FILE=data/tasks.json

# Port of the API server (the Vite dev proxy reads this too). Default: 3001
# SERVER_PORT=3001

# Cloud providers: parallel calls per provider, timeout per call, retries after a
# rate limit (429) or server error (5xx), with backoff
LLM_CONCURRENCY=2
LLM_TIMEOUT_MS=60000
LLM_RETRIES=2

# Mock mode: each fake answer waits a random time in this range (ms)
MOCK_MIN_DELAY_MS=1500
MOCK_MAX_DELAY_MS=4000
# Extra wait before a plan or first report: the agent first walks to the desk and sits.
MOCK_WALK_IN_MS=4500

# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---
# The free tier is small: in November 2026 gemini-3.6-flash allowed 20 requests a day
# (a task makes about 7–10). Your current limits: https://ai.dev/rate-limit
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Ollama (local models, no key; https://ollama.com) ---
# Pull a model first, e.g. `ollama pull qwen3.5:9b`. Local models get one call at a
# time and more patience by default.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONCURRENCY=1
OLLAMA_TIMEOUT_MS=240000
# Context window (prompt + answer, tokens). Ollama's own default of 4096 silently cuts
# long prompts, e.g. a worker that gets its teammates' approved reports.
OLLAMA_NUM_CTX=16384

# --- OpenRouter (many models behind one key: https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
